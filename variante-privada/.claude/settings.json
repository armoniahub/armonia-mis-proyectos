{
  "permissions": {
    "allow": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git push origin*)",
      "Bash(git pull*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(.env*)"
    ]
  },
  "extraKnownMarketplaces": {
    "armonia": {
      "source": {
        "source": "github",
        "repo": "armonia-proyectos/armonia-marketplace"
      },
      "autoUpdate": false
    }
  }
}
